extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
    .container.my-3
        .row
            .col-12
                +box-head("Danh sach san pham")

        .row
            each item in products
                .col-4.mb-3
                    .product-item
                        .inner-image
                            img(
                                src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ90pBhti56F0VEPpu1A3ItikhKxbPFVUwxqA&s"
                                alt=item.title
                            )

                        .inner-content
                            h3.inner-title= item.title
                            .inner-price-new #{item.priceNew}$
                            .inner-price-old #{item.price}$
                            .inner-discount #{item.discountPercentage}%